# Optional environment settings. This file is documentation only:
# export/set these variables in your shell; .env is not loaded automatically.
# Persisted Settings in the UI take precedence over the provider default.
MEMORYRUSH_PROVIDER=preview

# Leave unset to keep private data outside the repository:
# Windows: %LOCALAPPDATA%/MemoryRush; other systems: ~/.local/share/MemoryRush.
# MEMORYRUSH_DATA_DIR=/path/to/private/memoryrush

# Optional Windows launcher paths; not required for -Ollama or -ApiOnly.
# MEMORYRUSH_LLAMA_SERVER=/path/to/llama-server.exe
# MEMORYRUSH_MODEL_PATH=/path/to/model.gguf

# For explicitly enabled external API use, set MEMORYRUSH_API_KEY privately.
# Never commit a real key. Configure endpoint/model and consent in Settings.
